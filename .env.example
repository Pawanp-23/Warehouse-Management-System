# Local development only. Production values must come from a secret manager.
MONGODB_URI=mongodb://127.0.0.1:27018/?replicaSet=wms-rs
MONGODB_DATABASE=whitfield_wms
APP_ENV=development
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3005
TRUSTED_HOSTS=localhost,127.0.0.1

# Authentication is enabled locally too; never use header identity for a business system.
AUTH_REQUIRED=true
JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_ISSUER=whitfield-wms
JWT_AUDIENCE=whitfield-api
DOCS_ENABLED=true

MAX_REQUEST_BODY_BYTES=2000000
RATE_LIMIT_REQUESTS=300
RATE_LIMIT_WINDOW_SECONDS=60
IDEMPOTENCY_TTL_HOURS=24
MONGO_SERVER_SELECTION_TIMEOUT_MS=5000
MONGO_CONNECT_TIMEOUT_MS=5000
MONGO_MAX_POOL_SIZE=50

# Optional. Without a key, the assistant remains functional in local extractive-RAG mode.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-5.6-luna
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# auto prefers Gemini, then OpenAI, then local extractive RAG.
AI_PROVIDER=auto
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
MANAGER_INVITE_CODE=replace-me
ADMIN_INVITE_CODE=replace-me
KNOWLEDGE_MAX_FILE_BYTES=1500000
KNOWLEDGE_TOP_K=5
